# Discord Configuration
# Required for Discord OAuth and membership verification
# Get these from Discord Developer Portal: https://discord.com/developers/applications
DISCORD_GUILD_ID=1254761492608188517
DISCORD_BOT_TOKEN=your-discord-bot-token

# GitHub Configuration
# Required for feedback system (creates GitHub issues)
# Create personal access token at: https://github.com/settings/tokens
# Requires 'repo' scope
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=vendoreval3

# Anthropic Claude API
# Required for corporate tone generation
# Get API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Supabase Configuration
# These are automatically set by Supabase CLI - DO NOT edit manually
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=auto-generated-by-cli
# SUPABASE_SERVICE_ROLE_KEY=auto-generated-by-cli
