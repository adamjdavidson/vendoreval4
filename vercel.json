{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd apps/docs && npm install && npm run build && cd ../evaluation-tool && npm install && npm run build",
  "installCommand": "echo 'Dependencies installed in build command'",
  "rewrites": [
    {
      "source": "/evaluate/:path*",
      "destination": "/apps/evaluation-tool/dist/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/apps/docs/build/:path*"
    }
  ],
  "outputDirectory": ".",
  "framework": null
}
